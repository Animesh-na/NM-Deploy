// Grafana Alloy: ships the stdout/stderr logs of this compose project's
// containers to Loki. Reads the Docker API through the read-only socket mount.
//
// Stream labels (low cardinality only):
//   source    backend | frontend | infrastructure
//             backend  = the Go API and worker (api-*, worker, migrate)
//             frontend = browser logs the API ingested (log_type=frontend)
//             infrastructure = edge, web, postgres, redis, rabbitmq, observability
//   log_type  access | activity | db | frontend | app   (backend and frontend only)
//   level     debug | info | warn | error
//   service   compose service name; container
//
// Structured metadata (indexed for exact lookups, not stream labels):
//   trace_id, span_id, request_id — Grafana links log lines to Tempo traces.
// Everything else (event, outcome, user_id, route, status, sql, ...) stays in
// the JSON line: query it with `| json`.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=voyage-platform"]
  }
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.containers.output
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.app.receiver]
}

loki.process "app" {
  // Default: infrastructure. Backend services and their ingested browser logs
  // are re-labelled below.
  stage.static_labels {
    values = { source = "infrastructure" }
  }

  stage.match {
    selector = "{service=~\"api-.*|worker|migrate\"}"

    // The Go services log one JSON object per line (slog).
    stage.json {
      expressions = {
        level      = "level",
        log_type   = "log_type",
        trace_id   = "trace_id",
        span_id    = "span_id",
        request_id = "request_id",
      }
    }
    stage.template {
      source   = "level"
      template = "{{ ToLower .Value }}"
    }
    stage.template {
      source   = "log_type"
      template = "{{ if .Value }}{{ .Value }}{{ else }}app{{ end }}"
    }
    stage.labels {
      values = { level = "", log_type = "" }
    }
    stage.static_labels {
      values = { source = "backend" }
    }
    stage.structured_metadata {
      values = { trace_id = "", span_id = "", request_id = "" }
    }
  }

  // Browser logs travel through the API but are the frontend's.
  stage.match {
    selector = "{log_type=\"frontend\"}"
    stage.static_labels {
      values = { source = "frontend" }
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
