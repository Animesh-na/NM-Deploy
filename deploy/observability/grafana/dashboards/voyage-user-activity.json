          "rawSql": "SELECT u.email, u.id, u.role, u.is_active AS active, o.name AS organization\nFROM users u LEFT JOIN organizations o ON o.id = u.organization_id ORDER BY u.email",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
