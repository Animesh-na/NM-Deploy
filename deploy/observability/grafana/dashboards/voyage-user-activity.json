    {
      "id": 15,
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{log_type=\"activity\"} | json | user_id=~\"$user_id\" | event=~\"$event\" | line_format \"{{.event}}  {{.outcome}}  {{if .sheet_id}}sheet={{.sheet_id}} {{end}}{{if .workbook_id}}workbook={{.workbook_id}} {{end}}{{if .code}}code={{.code}} {{end}}user={{.user_id}}\"",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "type": "logs",
      "title": "Events (set User id; open a line for View trace)",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    }
