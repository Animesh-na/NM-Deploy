    {
      "id": 15,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT a.occurred_at AS time, a.event, a.outcome, u.email AS \"user\", t.email AS target, o.name AS organization,\n       a.client_ip, a.reason, a.trace_id\nFROM audit_events a\nLEFT JOIN users u ON u.id = a.user_id\nLEFT JOIN users t ON t.id = a.target_user_id\nLEFT JOIN organizations o ON o.id = a.organization_id\nWHERE $__timeFilter(a.occurred_at)\n  AND (${user_id:sqlstring} = '.*' OR a.user_id::text = ${user_id:sqlstring} OR a.target_user_id::text = ${user_id:sqlstring})\nORDER BY a.occurred_at DESC LIMIT 500",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "type": "table",
      "title": "Audit events (filtered by the selected user, as actor or target)",
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
