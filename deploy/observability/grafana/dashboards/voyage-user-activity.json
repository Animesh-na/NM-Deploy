          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (event, outcome) (increase(user_activity_total{outcome!~\"success|mfa_required\"}[$__rate_interval]))",
          "legendFormat": "{{event}} {{outcome}}"
        }
