            "uid": "loki"
          },
          "expr": "sum by (client_ip, outcome) (count_over_time({log_type=\"activity\"} | json | event=\"auth.signin\" | outcome=~\"denied|failure\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "type": "table",
      "title": "Failed sign-ins by client IP",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Last *",
            "desc": true
