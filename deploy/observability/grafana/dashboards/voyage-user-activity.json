      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT COALESCE(u.email, 'unknown email #' || left(a.email_hash, 8)) AS account, a.reason, count(*) AS attempts, max(a.occurred_at) AS last_attempt\nFROM audit_events a LEFT JOIN users u ON u.id = a.target_user_id\nWHERE a.event = 'auth.signin' AND a.outcome IN ('denied', 'failure') AND $__timeFilter(a.occurred_at)\nGROUP BY 1, 2 ORDER BY attempts DESC LIMIT 20",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "type": "table",
      "title": "Failed sign-ins by account (audit trail)",
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
