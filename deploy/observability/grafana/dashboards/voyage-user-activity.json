    {
      "id": 14,
      "type": "row",
      "title": "Audit trail (PostgreSQL, AUDIT_RETENTION_DAYS) — sign-in, account, admin, reference data",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
