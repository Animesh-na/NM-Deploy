          "expr": "{log_type=\"db\"} | json | line_format \"{{.msg}}  {{.duration_ms}} ms  rows={{.rows}}  {{.error}}  |  {{.sql}}\"",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "type": "logs",
      "title": "Failed and slow SQL statements (placeholders only, never values)",
      "options": {
        "showTime": true,
