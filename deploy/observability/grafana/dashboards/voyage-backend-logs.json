          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (method, route, status) (count_over_time({log_type=\"access\"} | json | status >= 400 [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "type": "table",
      "title": "Failing routes (4xx/5xx)",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Last *",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "transformations": [
        {
