  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Backend logs (API and worker)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
