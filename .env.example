# Copy to .env (gitignored) and fill in. Generate secrets, e.g. `openssl rand -hex 32`.
# Never commit real values.

# --- required secrets ---
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
JWT_SECRET=
# 32-byte key, hex (64 chars): openssl rand -hex 32
MFA_ENCRYPTION_KEY=
# First admin account, created by the migrate job.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- public URL ---
# The URL users open. Used as the allowed WebSocket origin.
PUBLIC_ORIGIN=http://localhost:8080
# Host port of the edge proxy (bound to 127.0.0.1).
EDGE_PORT=8080

# --- calculation authority (M10) ---
# local | server_display | server_only. Rollback = local + restart api-1/api-2.
CALC_AUTHORITY=local

# --- optional integrations (empty = feature unavailable / code default) ---
EXCHANGERATE_API_KEY=
FLEETGO_API_KEY=
FLEETGO_BASE_URL=
# Sea-route distance service. It is NOT part of this stack; set its URL if you run one.
SEAROUTE_SERVICE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=

# --- frontend build args: PUBLIC values only (they end up in the JS bundle) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_LOVABLE_CONNECTOR_MAPBOX_PUBLIC_TOKEN=
